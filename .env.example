# Default zero-cost local mode
PROVIDER_MODE=local
DATABASE_URL=sqlite:///./backend/ultramedia.db
NEXT_PUBLIC_ULTRAMEDIA_API_URL=http://localhost:8000

# Reuse the corresponding secrets from CommonGroundAI through your secret manager.
# Never commit real values.
FIREWORKS_API_KEY=
FIREWORKS_CHAT_MODEL=accounts/fireworks/models/qwen3p7-plus
FIREWORKS_EMBEDDING_MODEL=accounts/fireworks/models/qwen3-embedding-8b
FIREWORKS_RERANK_MODEL=accounts/fireworks/models/qwen3-reranker-8b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=ultramedia-public-v1
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ultramedia-production

# Optional local model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Production reviewer authentication
APPROVAL_API_KEY=
